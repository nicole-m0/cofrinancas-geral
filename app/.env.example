# EXPO_PUBLIC_API_URL — URL da API servida pelo painel-admin (Next.js).
#
# Precedência do Expo (@expo/env), do maior para o menor:
#   .env.<mode>.local  >  .env.local  >  .env.<mode>  >  .env
#   mode = "development" em `expo start`; "production" em `expo export` / builds EAS.
#
# Versionados no repo:
#   .env.development  ->  http://localhost:3000           (dev local)
#   .env.production   ->  https://painel-admin-vert.vercel.app  (produção)
#
# Para sobrescrever localmente sem alterar o repo, crie um destes (ignorados pelo git):
#   .env.local                 -> vale em dev e prod
#   .env.development.local      -> só em dev  (ex.: IP da LAN p/ celular físico)
#
# Exemplos de valor:
#   web local:            http://localhost:3000
#   device físico / LAN:  http://SEU_IP_LOCAL:3000
#   produção (Vercel):    https://painel-admin-vert.vercel.app
EXPO_PUBLIC_API_URL=http://localhost:3000
